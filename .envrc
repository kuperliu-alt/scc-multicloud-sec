#!/bin/bash
# ==============================================================================
# Universal Project Workspace Environment (.envrc)
# ==============================================================================

# 1. Export workspace root path
export WORKSPACE_ROOT="${PWD}"

# 2. Automatically load local .env if it exists
if [ -f .env ]; then
  # Load .env file using direnv's built-in dotenv if supported, or source it
  if type dotenv &>/dev/null; then
    dotenv .env
  else
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
  fi
fi

# 3. Optional: Add local scripts / bin directory to PATH
if [ -d "${PWD}/bin" ]; then
  PATH_add "${PWD}/bin"
fi
