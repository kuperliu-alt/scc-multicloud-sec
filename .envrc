#!/bin/bash
# ==============================================================================
# Universal Project Workspace Environment (.envrc)
# ==============================================================================

# 1. Export workspace root path
export WORKSPACE_ROOT="${PWD}"

# 2. Google Cloud CLI Physical Session Isolation
# Isolates gcloud auth, active project, and ADC locally to prevent cross-project contamination
export CLOUDSDK_CONFIG="${PWD}/.gcloud"
unset GOOGLE_APPLICATION_CREDENTIALS

# 3. Automatically load local .env if it exists
if [ -f .env ]; then
  if type dotenv &>/dev/null; then
    dotenv .env
  else
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
  fi
fi

# 4. Optional: Add local scripts / bin directory to PATH
if [ -d "${PWD}/bin" ]; then
  PATH_add "${PWD}/bin"
fi
