# General Project Settings
PROJECT_NAME="my-project"
ENVIRONMENT="development"
LOG_LEVEL="info"

# Google Cloud Physical Session Isolation (Enabled by default via .envrc)
# CLOUDSDK_CONFIG="${WORKSPACE_ROOT}/.gcloud"
# CLOUDSDK_CORE_PROJECT="your-gcp-project-id"
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Custom workspace configurations & secrets (Do NOT commit actual .env)
# API_KEY="your-api-key-here"
# DATABASE_URL="your-database-url"
